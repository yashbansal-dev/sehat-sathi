# Application Configuration
APP_NAME="Sehat Sathi AI - The Two-Minute Doctor"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (Defaults to SQLite for instant local dev, switchable to PostgreSQL)
DATABASE_URL="sqlite:///./sehat_sathi.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sehat_sathi"

# Security & Tokens
SECRET_KEY="sehat-sathi-super-secure-production-secret-change-in-prod-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Storage
UPLOAD_DIR="./storage/uploads"
SYNTHETIC_DIR="./storage/synthetic"
MAX_UPLOAD_SIZE_MB=15

# Optional AI LLM Provider (falls back transparently to clinical NLP extractor when unconfigured)
LLM_API_KEY=""
LLM_MODEL="gemini-1.5-pro"
USE_SYNTHETIC_AI_FALLBACK=True

# Firebase Auth Configuration (Optional)
FIREBASE_PROJECT_ID=""
USE_MOCK_AUTH_FALLBACK=True
